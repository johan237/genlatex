# Public build-time settings only. Never put API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
# Optional actual source repository URL, used in the footer.
NEXT_PUBLIC_SOURCE_URL=
# Optional original server workspace for server-assisted conversion tools.
# Configure its CORS policy for your static site's origin.
NEXT_PUBLIC_SERVER_URL=
