\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{section-borders}[2026/02/17 Section Border Styles - Validated]

% ============================================================
% Section Border Styles Package
% Pre-validated and guaranteed to work
% Uses mdframed for advanced borders
% ============================================================

\RequirePackage{xcolor}
\RequirePackage{mdframed}

% ------------------------------------------------------------
% Define Standard Colors
% ------------------------------------------------------------

\definecolor{borderblue}{RGB}{0, 118, 186}
\definecolor{bordergreen}{RGB}{46, 184, 92}
\definecolor{borderred}{RGB}{220, 53, 69}
\definecolor{bordergray}{RGB}{108, 117, 125}
\definecolor{borderorange}{RGB}{255, 159, 67}

% ------------------------------------------------------------
% Basic Section Border Environments
% ------------------------------------------------------------

% Simple gray border
\newmdenv[
    linewidth=1pt,
    linecolor=bordergray,
    topline=true,
    bottomline=true,
    leftline=true,
    rightline=true,
    skipabove=10pt,
    skipbelow=10pt,
    innertopmargin=10pt,
    innerbottommargin=10pt,
    innerleftmargin=10pt,
    innerrightmargin=10pt
]{graysection}

% Blue border (for information)
\newmdenv[
    linewidth=2pt,
    linecolor=borderblue,
    topline=true,
    bottomline=true,
    leftline=true,
    rightline=true,
    skipabove=12pt,
    skipbelow=12pt,
    innertopmargin=12pt,
    innerbottommargin=12pt,
    innerleftmargin=12pt,
    innerrightmargin=12pt,
    backgroundcolor=borderblue!5
]{bluesection}

% Green border (for success/positive content)
\newmdenv[
    linewidth=2pt,
    linecolor=bordergreen,
    topline=true,
    bottomline=true,
    leftline=true,
    rightline=true,
    skipabove=12pt,
    skipbelow=12pt,
    innertopmargin=12pt,
    innerbottommargin=12pt,
    innerleftmargin=12pt,
    innerrightmargin=12pt,
    backgroundcolor=bordergreen!5
]{greensection}

% Red border (for warnings/important notes)
\newmdenv[
    linewidth=2pt,
    linecolor=borderred,
    topline=true,
    bottomline=true,
    leftline=true,
    rightline=true,
    skipabove=12pt,
    skipbelow=12pt,
    innertopmargin=12pt,
    innerbottommargin=12pt,
    innerleftmargin=12pt,
    innerrightmargin=12pt,
    backgroundcolor=borderred!5
]{redsection}

% Orange border (for caution)
\newmdenv[
    linewidth=2pt,
    linecolor=borderorange,
    topline=true,
    bottomline=true,
    leftline=true,
    rightline=true,
    skipabove=12pt,
    skipbelow=12pt,
    innertopmargin=12pt,
    innerbottommargin=12pt,
    innerleftmargin=12pt,
    innerrightmargin=12pt,
    backgroundcolor=borderorange!5
]{orangesection}

% ------------------------------------------------------------
% Left Bar Accent Borders
% ------------------------------------------------------------

% Blue left bar
\newmdenv[
    linewidth=4pt,
    linecolor=borderblue,
    topline=false,
    bottomline=false,
    leftline=true,
    rightline=false,
    skipabove=12pt,
    skipbelow=12pt,
    innertopmargin=8pt,
    innerbottommargin=8pt,
    innerleftmargin=12pt,
    innerrightmargin=8pt,
    backgroundcolor=borderblue!3
]{leftbarblue}

% Green left bar
\newmdenv[
    linewidth=4pt,
    linecolor=bordergreen,
    topline=false,
    bottomline=false,
    leftline=true,
    rightline=false,
    skipabove=12pt,
    skipbelow=12pt,
    innertopmargin=8pt,
    innerbottommargin=8pt,
    innerleftmargin=12pt,
    innerrightmargin=8pt,
    backgroundcolor=bordergreen!3
]{leftbargreen}

% ------------------------------------------------------------
% Shadow Box Border
% ------------------------------------------------------------

\newmdenv[
    linewidth=1pt,
    linecolor=black!40,
    shadow=true,
    shadowsize=6pt,
    shadowcolor=black!20,
    skipabove=15pt,
    skipbelow=15pt,
    innertopmargin=10pt,
    innerbottommargin=10pt,
    innerleftmargin=10pt,
    innerrightmargin=10pt
]{shadowsection}

% ------------------------------------------------------------
% Rounded Corner Borders
% ------------------------------------------------------------

\newmdenv[
    linewidth=2pt,
    linecolor=borderblue,
    roundcorner=8pt,
    skipabove=12pt,
    skipbelow=12pt,
    innertopmargin=10pt,
    innerbottommargin=10pt,
    innerleftmargin=10pt,
    innerrightmargin=10pt,
    backgroundcolor=borderblue!5
]{roundedblue}

\newmdenv[
    linewidth=2pt,
    linecolor=bordergreen,
    roundcorner=8pt,
    skipabove=12pt,
    skipbelow=12pt,
    innertopmargin=10pt,
    innerbottommargin=10pt,
    innerleftmargin=10pt,
    innerrightmargin=10pt,
    backgroundcolor=bordergreen!5
]{roundedgreen}

