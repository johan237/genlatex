% ------------------------------------------------------------
% Decorative Corner Page Border
% ------------------------------------------------------------

\newcommand{\enablecornerpageorder}{%
    \AddToHook{shipout/background}{%
        \begin{tikzpicture}[remember picture, overlay]
            % Main border
            \draw[line width=1pt, black]
                ($(current page.north west) + (1cm,-1cm)$) rectangle
                ($(current page.south east) + (-1cm,1cm)$);

            % Decorative corners (top-left)
            \draw[line width=2pt, black]
                ($(current page.north west) + (1cm,-1cm)$) --
                ($(current page.north west) + (2.5cm,-1cm)$);
            \draw[line width=2pt, black]
                ($(current page.north west) + (1cm,-1cm)$) --
                ($(current page.north west) + (1cm,-2.5cm)$);

            % Decorative corners (top-right)
            \draw[line width=2pt, black]
                ($(current page.north east) + (-1cm,-1cm)$) --
                ($(current page.north east) + (-2.5cm,-1cm)$);
            \draw[line width=2pt, black]
                ($(current page.north east) + (-1cm,-1cm)$) --
                ($(current page.north east) + (-1cm,-2.5cm)$);

            % Decorative corners (bottom-left)
            \draw[line width=2pt, black]
                ($(current page.south west) + (1cm,1cm)$) --
                ($(current page.south west) + (2.5cm,1cm)$);
            \draw[line width=2pt, black]
                ($(current page.south west) + (1cm,1cm)$) --
                ($(current page.south west) + (1cm,2.5cm)$);

            % Decorative corners (bottom-right)
            \draw[line width=2pt, black]
                ($(current page.south east) + (-1cm,1cm)$) --
                ($(current page.south east) + (-2.5cm,1cm)$);
            \draw[line width=2pt, black]
                ($(current page.south east) + (-1cm,1cm)$) --
                ($(current page.south east) + (-1cm,2.5cm)$);
        \end{tikzpicture}%
    }%
}

% ------------------------------------------------------------
% Disable Page Borders
% ------------------------------------------------------------

\newcommand{\disablepageorders}{%
    \RemoveFromHook{shipout/background}%
}

% ------------------------------------------------------------
% Usage Instructions (commented out)
% ------------------------------------------------------------

% Add ONE of these commands to your preamble:
%
% \enablesimplepageorder      % Simple single-line border
% \enabledoublepageorder      % Double-line border
% \enablebluepageorder        % Blue colored border
% \enablegreenpageorder       % Green colored border
% \enablethickpageorder       % Thick border
% \enablecornerpageorder      % Decorative corner accents
%
% To remove borders:
% \disablepageorders

