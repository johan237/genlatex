\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{page-borders}[2026/02/17 Page Border Styles - Validated]

% ============================================================
% Page Border Styles Package
% Pre-validated and guaranteed to work
% Adds borders around entire pages
% ============================================================

\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{tikz}
\usetikzlibrary{calc}

% ------------------------------------------------------------
% Simple Page Border
% ------------------------------------------------------------

\newcommand{\enablesimplepageorder}{%
    \AddToHook{shipout/background}{%
        \begin{tikzpicture}[remember picture, overlay]
            \draw[line width=1pt, black]
                ($(current page.north west) + (1cm,-1cm)$) rectangle
                ($(current page.south east) + (-1cm,1cm)$);
        \end{tikzpicture}%
    }%
}

% ------------------------------------------------------------
% Double Page Border
% ------------------------------------------------------------

\newcommand{\enabledoublepageorder}{%
    \AddToHook{shipout/background}{%
        \begin{tikzpicture}[remember picture, overlay]
            % Outer border
            \draw[line width=1pt, black]
                ($(current page.north west) + (1cm,-1cm)$) rectangle
                ($(current page.south east) + (-1cm,1cm)$);
            % Inner border
            \draw[line width=0.5pt, black]
                ($(current page.north west) + (1.3cm,-1.3cm)$) rectangle
                ($(current page.south east) + (-1.3cm,1.3cm)$);
        \end{tikzpicture}%
    }%
}

% ------------------------------------------------------------
% Colored Page Border
% ------------------------------------------------------------

\newcommand{\enablebluepageorder}{%
    \AddToHook{shipout/background}{%
        \begin{tikzpicture}[remember picture, overlay]
            \draw[line width=2pt, blue!60]
                ($(current page.north west) + (1cm,-1cm)$) rectangle
                ($(current page.south east) + (-1cm,1cm)$);
        \end{tikzpicture}%
    }%
}

\newcommand{\enablegreenpageorder}{%
